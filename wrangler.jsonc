{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rajanna-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",

  // ./out is the Next.js static export. Cloudflare serves these files directly
  // from its edge without invoking the Worker, so the whole site costs zero
  // Worker requests — only POST /api/contact does.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Next writes 404.html; serve it with a real 404 status for unmatched paths.
    "not_found_handling": "404-page",

    // Matches the canonical URLs the site emits, which have no trailing slash.
    // Do NOT change this without also changing every canonical in lib/seo.ts.
    "html_handling": "auto-trailing-slash",

    // Only the contact endpoint reaches the Worker. Everything else is a file.
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }
}
