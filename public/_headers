# Cloudflare response headers. Works on both Workers static assets and Pages.
# Syntax: a URL pattern, then indented "Header: value" lines.
# Limits: 100 rules, 2000 characters per line.
# Verify after deploy:  curl -sI https://rajanna.dev | grep -i strict-transport

# ── Content-Type for the generated images ─────────────────────────────────────
# Next exports OG images to extensionless paths (out/opengraph-image, not
# .../opengraph-image.png). Cloudflare infers MIME type from the extension, so
# without these rules every card is served as application/octet-stream and every
# link preview on WhatsApp, LinkedIn, Slack and X silently breaks.
/opengraph-image
  Content-Type: image/png
/twitter-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
/work/opengraph-image
  Content-Type: image/png
/work/:slug/opengraph-image
  Content-Type: image/png
/work/:slug/twitter-image
  Content-Type: image/png

# ── The duplicate-content guard ───────────────────────────────────────────────
# The project also serves at <project>.workers.dev / <project>.pages.dev with
# byte-identical content. Indexed, those split the ranking signal — the mistake
# already fixed once on RosterBay. noindex the preview hosts, never the apex.
https://:project.workers.dev/*
  X-Robots-Tag: noindex, nofollow
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:commit.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# ── Security (all routes) ─────────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ── Caching ───────────────────────────────────────────────────────────────────
# Content-hashed filenames are immutable forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Case screenshots are renamed when they change, so they are safe to pin long.
/cases/*
  Cache-Control: public, max-age=2592000
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
